@startuml
title SD1 - Spot Reservation, LPR Gate Entry & No-Show Destruction

actor Student
boundary ":StudentDashboardUI" as UI
control ":ReservationControl" as Ctrl
entity "spot : ParkingSpot" as Spot
entity "res : Reservation" as Res
boundary ":LprGateBoundary" as LPR

Student -> UI : onReserveSpotClicked("EV-04", "12-345-67")
activate UI

UI -> Ctrl : reserveSpot(userId, "EV-04", "12-345-67")
activate Ctrl

Ctrl -> Spot : isAvailable()
activate Spot
Spot --> Ctrl : available
deactivate Spot

alt available == true
    Ctrl -> Spot : tryReserve(expectedVersion)
    activate Spot
    Spot --> Ctrl : acquired
    deactivate Spot

    alt acquired == true
        create Res
        Ctrl -> Res : <<create>>
        activate Res
        Res --> Ctrl : res
        deactivate Res
        Ctrl --> UI : res
        UI -> UI : displayCountdown(15)
    else Concurrent Race Condition
        Ctrl --> UI : null
        UI -> UI : showErrorAlert("Spot just reserved by another user")
    end
else else
    Ctrl --> UI : null
    UI -> UI : showErrorAlert("Spot unavailable")
end

deactivate Ctrl
deactivate UI

== Within 15 Minutes: Vehicle Arrives at Entrance Gate ==

activate LPR
LPR -> Ctrl : processLprGateEntry("12-345-67", "EV Zone")
activate Ctrl

Ctrl -> Res : isWithin15MinWindow()
activate Res
Res --> Ctrl : valid
deactivate Res

alt valid == true
    Ctrl -> Res : setStatus(FULFILLED)
    activate Res
    deactivate Res
    Ctrl -> LPR : openBarrierGate()
else No-Show > 15 Min
    Ctrl -> Res : setStatus(NO_SHOW_REVOKED)
    activate Res
    deactivate Res
    destroy Res
    Ctrl -> LPR : denyEntry("Reservation revoked: no-show")
end

Ctrl --> LPR : entryResult
deactivate Ctrl
deactivate LPR

@enduml

@startuml
title SD2 - EV Charging 30-Minute Idle Penalty

participant ":IdlePenaltyScheduler" as Timer <<system>>
control ":EvBillingControl" as Billing
entity "session : ChargingSession" as Session
entity "fine : Violation" as Fine
boundary ":SmsGatewayBoundary" as SMS

activate Timer
Timer -> Billing : applyIdlePenalties()
activate Billing

loop for each completed ChargingSession
    Billing -> Session : isIdleOver30Minutes()
    activate Session
    Session --> Billing : overdue
    deactivate Session

    alt overdue == true (isPhysicallyOccupied == true)
        create Fine
        Billing -> Fine : <<create>> ("Charger Idle Penalty", 5.0 NIS/hr)
        activate Fine
        Fine --> Billing : fine
        deactivate Fine

        Billing -> SMS : sendSmsAlert(phoneNumber, "Idle penalty of 5 NIS/hr applied.")
        activate SMS
        deactivate SMS
    end
end

Billing --> Timer
deactivate Billing
deactivate Timer

@enduml