@startuml

enum UserRole {
    STUDENT
    FACULTY
    SECURITY_GUARD
    TRAFFIC_ADMIN
}

enum SpotStatus {
    AVAILABLE
    RESERVED
    OCCUPIED
}

enum ReservationStatus {
    ACTIVE
    FULFILLED
    NO_SHOW_REVOKED
}

enum AppealDecision {
    PENDING
    APPROVED
    REJECTED
}

' ===== Boundary =====
class StudentDashboardUI <<boundary>> {
    - selectedZone: String
    + displayAvailableSpots(spots: List<ParkingSpot>): void
    + onReserveSpotClicked(spotId: String): void
    + onSubmitAppealClicked(violationId: String, reasonText: String): void
    + displayCountdown(minutesLeft: int): void
    + showErrorAlert(message: String): void
}

class GuardTerminalUI <<boundary>> {
    + onLogViolationClicked(licensePlate: String, reason: String): void
    + onIssueGuestQrClicked(guestPlate: String): void
}

class AdminAppealUI <<boundary>> {
    + onReviewAppealClicked(appealId: String, decision: AppealDecision): void
}

class LprGateBoundary <<boundary>> {
    + onPlateScanned(licensePlate: String): void
    + onGuestQrScanned(qrToken: String): void
    + openBarrierGate(): void
    + denyEntry(reason: String): void
}

class PaymentGatewayBoundary <<boundary>> {
    + authorizeCreditCard(amount: double): String
}

class SmsGatewayBoundary <<boundary>> {
    + sendSmsAlert(phoneNumber: String, message: String): void
}

' ===== Control =====
class ReservationControl <<control>> {
    - reservationWindowMin: int
    + findAvailableSpots(zoneId: String): List<ParkingSpot>
    + reserveSpot(userId: String, spotId: String, licensePlate: String): Reservation
    + processLprGateEntry(licensePlate: String): boolean
    + validateGuestQrEntry(qrToken: String): boolean
    + revokeExpiredReservations(): void
}

class EvBillingControl <<control>> {
    - idleGraceMin: int
    - idleRateNisPerHour: double
    + authorizeEvPayment(reservationId: String, amount: double): PaymentAuthorization
    + notifyChargeComplete(sessionId: String): void
    + applyIdlePenalties(sessionId: String): void
}

class EnforcementControl <<control>> {
    + issueGuestPass(guestPlate: String, expiresAt: Date): GuestPass
    + logSevereViolation(licensePlate: String, reason: String, fineAmount: double): Violation
    + submitDigitalAppeal(violationId: String, reasonText: String): Appeal
    + reviewDigitalAppeal(appealId: String, decision: AppealDecision): void
}

' ===== Entity =====
abstract class User <<entity>> {
    - userId: String
    - fullName: String
    - email: String
    - phoneNumber: String
    - role: UserRole
    - noShowWarnings: int
    + incrementNoShowWarnings(): void
}

class Student <<entity>> {
    - studentId: String
    - activePermit: boolean
    + hasActivePermit(): boolean
}

class Faculty <<entity>> {
    - facultyId: String
    - department: String
    - activePermit: boolean
    + hasActivePermit(): boolean
}

class SecurityGuard <<entity>> {
    - badgeNumber: String
}

class TrafficAdministrator <<entity>> {
    - adminOfficeId: String
}

class GuestPass <<entity>> {
    - qrToken: String
    - guestPlate: String
    - expiresAt: Date
    - isUsed: boolean
    + isValid(): boolean
    + markUsed(): void
}

class Vehicle <<entity>> {
    - licensePlate: String
}

class ParkingZone <<entity>> {
    - zoneId: String
    - zoneName: String
    - totalCapacity: int
}

class ParkingSpot <<entity>> {
    - spotId: String
    - isEvCharger: boolean
    - status: SpotStatus
    - version: int
    + isAvailable(): boolean
    + tryReserve(expectedVersion: int): boolean
    + setStatus(status: SpotStatus): void
}

class Reservation <<entity>> {
    - reservationId: String
    - createdAt: Date
    - expiresAt: Date
    - status: ReservationStatus
    + isWithin15MinWindow(): boolean
    + setStatus(status: ReservationStatus): void
}

class PaymentAuthorization <<entity>> {
    - authId: String
    - gatewayToken: String
    - authorizedAmount: double
    - authorizedAt: Date
}

class ChargingSession <<entity>> {
    - sessionId: String
    - completedAt: Date
    - vacatedAt: Date
    - isPluggedIn: boolean
    - isPhysicallyOccupied: boolean
    - idlePenaltyNis: double
    + isIdleOver30Minutes(): boolean
}

class Violation <<entity>> {
    - violationId: String
    - reason: String
    - fineAmount: double
    - isPaid: boolean
    + cancelFine(): void
}

class Appeal <<entity>> {
    - appealId: String
    - reasonText: String
    - decision: AppealDecision
    + setDecision(decision: AppealDecision): void
}

' ===== Inheritance =====
User <|-- Student
User <|-- Faculty
User <|-- SecurityGuard
User <|-- TrafficAdministrator

' ===== Aggregation / Composition =====
ParkingZone "1" o-- "1..*" ParkingSpot : contains
Reservation "1" *-- "0..1" PaymentAuthorization : requires for EV
Reservation "1" *-- "0..1" ChargingSession : initiates
Violation "1" *-- "0..1" Appeal : contested by

' ===== Entity associations =====
User "1" -- "0..*" Vehicle : owns
Vehicle "1" -- "0..*" Reservation : booked for
ParkingSpot "1" -- "0..*" Reservation : assigned to
Vehicle "1" -- "0..*" Violation : receives
SecurityGuard "0..1" -- "0..*" Violation : logs
SecurityGuard "1" -- "0..*" GuestPass : issues
TrafficAdministrator "0..1" -- "0..*" Appeal : reviews
User "0..*" -- "1" UserRole : has role
ParkingSpot "0..*" -- "1" SpotStatus : has status
Reservation "0..*" -- "1" ReservationStatus : has status
Appeal "0..*" -- "1" AppealDecision : has decision

' ===== Boundary - Control =====
StudentDashboardUI "0..*" -- "1" ReservationControl : reserves via
StudentDashboardUI "0..*" -- "1" EnforcementControl : appeals via
GuardTerminalUI "0..*" -- "1" EnforcementControl : logs via
AdminAppealUI "0..*" -- "1" EnforcementControl : reviews via
LprGateBoundary "0..*" -- "1" ReservationControl : reports entry to
EvBillingControl "1" -- "1" PaymentGatewayBoundary : authorizes via
EvBillingControl "1" -- "1" SmsGatewayBoundary : notifies via

' ===== Control - Entity =====
ReservationControl "1" -- "0..*" User : manages
ReservationControl "1" -- "0..*" Vehicle : identifies
ReservationControl "1" -- "0..*" ParkingZone : searches
ReservationControl "1" -- "0..*" ParkingSpot : reserves
ReservationControl "1" -- "0..*" Reservation : manages
ReservationControl "1" -- "0..*" GuestPass : validates
EvBillingControl "1" -- "0..*" PaymentAuthorization : creates
EvBillingControl "1" -- "0..*" ChargingSession : monitors
EvBillingControl "1" -- "0..*" Violation : applies penalties to
EnforcementControl "1" -- "0..*" Vehicle : checks
EnforcementControl "1" -- "0..*" GuestPass : issues
EnforcementControl "1" -- "0..*" Violation : manages
EnforcementControl "1" -- "0..*" Appeal : processes

@enduml